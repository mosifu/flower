.fc-card {
  position: relative;
  background: #fffdf7;
  border: 4rpx solid;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 18rpx rgba(120, 100, 60, 0.10);
  margin-bottom: 24rpx;
  transition: transform 0.2s ease;
}

.fc-hover {
  transform: scale(0.97);
}

.fc-cover {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
}

.fc-compact .fc-cover {
  height: 220rpx;
}

.fc-img {
  width: 100%;
  height: 100%;
  display: block;
}

.fc-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  background: #f0ece0;
}

/* 未收集：灰色半透明盖层（20% 透明度，插画清晰可见，仅轻微压暗区分状态） */
.fc-lock {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(150, 150, 145, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-lock-t {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.35);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.fc-count {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.fc-body {
  padding: 18rpx 20rpx 22rpx;
}

.fc-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #3e3a30;
  margin-bottom: 10rpx;
}

.fc-name-locked {
  color: #9a948a;
}

.fc-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  /* 统一预留右下角 AI 角标的宽度，保证所有卡片（含无角标的）尺寸一致 */
  padding-right: 68rpx;
}

/* 徽章禁止 flex 收缩与换行：容器挤压时中文会逐字换行（视觉竖排） */
.fc-meta .badge {
  flex-shrink: 0;
  white-space: nowrap;
}

.fc-ai {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  z-index: 2;
  font-size: 18rpx;
  line-height: 1.4;
  color: #8a8374;
  background: rgba(255, 253, 247, 0.92);
  border: 1rpx solid #d8d2c2;
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
}

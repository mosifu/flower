/* ===== 首页样式 ===== */
.home {
  padding-bottom: 40rpx;
}

.hero {
  padding: 40rpx 8rpx 30rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #3e7d5c;
  letter-spacing: 4rpx;
}

.hero-sub {
  margin-top: 12rpx;
  color: #8a8374;
  font-size: 26rpx;
}

.actions {
  margin: 20rpx 0 10rpx;
}

.action-main {
  font-size: 36rpx;
  padding: 30rpx 0;
}

.action-sub {
  margin-top: 20rpx;
}

.quota {
  text-align: center;
  margin-top: 18rpx;
}

.quota-num {
  color: #3e7d5c;
  font-weight: 700;
  font-size: 30rpx;
}

.progress-card {
  margin-top: 24rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 600;
}

.progress-track {
  height: 18rpx;
  background: #efe9da;
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #8fc99a, #3e7d5c);
  border-radius: 12rpx;
  transition: width 0.6s ease;
}

.progress-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.recent-scroll {
  white-space: nowrap;
  width: 100%;
}

.recent-row {
  display: inline-flex;
}

.recent-row flower-card {
  width: 260rpx;
  margin-right: 20rpx;
}

.empty-btn {
  margin: 30rpx auto 0;
  width: 320rpx;
}

.link-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

<!-- 首页：识花入口 + 收集进度 + 最近收获 -->
<view class="page home">
  <view class="hero fade-in">
    <view class="hero-title">🌸 随心一拍</view>
    <view class="hero-sub">花知道 · 把花收进你的花田</view>
  </view>

  <view class="actions">
    <view class="action-main btn-primary" data-source="camera" bindtap="onChoose">📷 拍照识花</view>
    <view class="action-sub btn-ghost" data-source="album" bindtap="onChoose">🖼 从相册选择（可多选）</view>
    <view class="quota muted">
      今日还可识别 <text class="quota-num">{{todayRemaining}}</text> 次
    </view>
  </view>

  <view class="card progress-card" bindtap="goAlbum">
    <view class="progress-head">
      <text class="progress-title">我的花田</text>
      <text class="muted">{{stats.collected}} / {{stats.total}} · {{stats.rate}}%</text>
    </view>
    <view class="progress-track">
      <view class="progress-bar" style="width: {{stats.rate}}%;"></view>
    </view>
    <view class="progress-foot muted">
      <text>等级：{{levelName}}</text>
      <text>点击查看图鉴 →</text>
    </view>
  </view>

  <!-- 识花时间线：左时间轴（按小时分组）+ 右节点内容（swiper 左右滑动），照片可预览 -->
  <view class="section-title">识花时间线</view>
  <view wx:if="{{timeline.length}}" class="card timeline-card">
    <view class="timeline-axis">
      <view
        wx:for="{{timeline}}"
        wx:key="hourTime"
        class="timeline-node {{timelineIndex === index ? 'timeline-node-active' : ''}}"
        data-index="{{index}}"
        bindtap="onTimelineTap"
      >
        <view class="timeline-dot"></view>
        <text class="timeline-label">{{item.hourLabel}}</text>
      </view>
    </view>
    <swiper
      class="timeline-swiper"
      current="{{timelineIndex}}"
      bindchange="onTimelineChange"
      circular="{{false}}"
      vertical
      disable-touch
    >
      <swiper-item wx:for="{{timeline}}" wx:key="hourTime">
        <view class="timeline-slide">
          <!-- 时间节点标题：居中展示 + 两侧分割线，清晰划分时间节点 -->
          <view class="timeline-slide-head">
            <view class="timeline-head-line"></view>
            <text class="timeline-head-label">{{item.hourLabel}}</text>
            <view class="timeline-head-line"></view>
          </view>
          <!-- 节点内记录：scroll-view 纵向滚动展示全部识花；
               滚到顶部（scrolltoupper）切上一节点、滚到底部（scrolltolower）切下一节点，实现连续浏览 -->
          <scroll-view
            class="timeline-records"
            scroll-y
            scroll-top="{{timelineScrollTops[index] || 0}}"
            data-index="{{index}}"
            bindscrolltoupper="onTimelineScrollToUpper"
            bindscrolltolower="onTimelineScrollToLower"
          >
            <view wx:for="{{item.records}}" wx:for-item="rec" wx:key="time" class="timeline-record">
              <view class="timeline-record-head">
                <text class="timeline-minute">{{rec.minuteLabel}}</text>
                <text class="timeline-flower-name" data-speciesid="{{rec.species._id}}" bindtap="onTimelineFlowerTap">{{rec.species.cnName}}</text>
                <text class="muted">第 {{rec.meetIndex}} 次遇见</text>
              </view>
              <view class="timeline-record-body">
                <image
                  class="timeline-photo"
                  src="{{rec.photo.fileID}}"
                  mode="aspectFill"
                  data-fileid="{{rec.photo.fileID}}"
                  bindtap="onTimelinePhotoTap"
                />
                <view class="timeline-photo-info">
                  <text wx:if="{{rec.photo.location}}" class="muted">📍 {{rec.photo.location}}</text>
                  <text wx:if="{{rec.photo.note}}" class="muted">{{rec.photo.note}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view wx:else class="empty">
    <text class="empty-icon">🌱</text>
    <view>还没有收集记录，快去拍第一朵花吧</view>
    <view class="btn-primary empty-btn" data-source="camera" bindtap="onChoose">去识花</view>
  </view>

  <view class="section-title">花匠之路</view>
  <view class="card link-card" bindtap="goAchievements">
    <text>🏅 查看成就徽章与等级</text>
    <text class="muted">→</text>
  </view>
</view>

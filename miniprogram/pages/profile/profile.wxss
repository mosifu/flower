/* ===== 我的页样式 ===== */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #eaf5ea, #fdfaf1);
  border-radius: 28rpx;
  padding: 36rpx 30rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #fffdf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 6rpx 16rpx rgba(120, 100, 60, 0.12);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 30rpx 10rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #3e7d5c;
}

.info-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.info-line {
  font-size: 26rpx;
  color: #6f6a5f;
  line-height: 1.6;
}

.about-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.about-line {
  font-size: 28rpx;
  line-height: 1.6;
}

.danger-line {
  color: #c0392b;
}

.modal-tip {
  font-size: 26rpx;
  color: #6f6a5f;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.modal-tip-warn {
  color: #c0392b;
}

.modal-input {
  width: 100%;
  background: #f7f4ec;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 确认按钮在确认词匹配前置灰 */
.btn-disabled {
  opacity: 0.45;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 620rpx;
  max-height: 70vh;
  background: #fffdf7;
  border-radius: 28rpx;
  padding: 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-body {
  max-height: 50vh;
}

.privacy-p {
  font-size: 26rpx;
  color: #6f6a5f;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.modal-btn {
  margin-top: 24rpx;
}

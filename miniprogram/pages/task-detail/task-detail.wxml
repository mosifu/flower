<!-- 识别任务详情页（三态）：identified 识别结果界面 / processing 识别中 / done 查看结果 -->
<view class="page task-detail">
  <view wx:if="{{loading}}" class="empty"><text class="empty-icon">⏳</text><view>加载中…</view></view>

  <!-- 识花结果（已收录花 swiper） -->
  <block wx:elif="{{showResult}}">
    <view class="success-wrap fade-in">
      <view class="success-badge">🎉 已收录 {{successCards.length}} 朵</view>
      <swiper class="success-swiper" current="{{successIndex}}" bindchange="onSuccessChange">
        <swiper-item wx:for="{{successCards}}" wx:key="speciesId">
          <view class="success-card rarity-{{item.rarity}}">
            <image wx:if="{{item.illustrationFileID}}" class="success-img" src="{{item.illustrationFileID}}" mode="aspectFill" />
            <view wx:else class="success-img success-placeholder">🌷</view>
            <view class="success-info">
              <text class="success-name">{{item.cnName}}</text>
              <text class="muted">{{item.latinName}}</text>
              <text class="badge badge-{{item.rarity}} success-rarity">第 {{item.meetCount}} 次遇见</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{successCards.length > 1}}" class="success-indicator muted">{{successIndex + 1}} / {{successCards.length}}</view>
      <view wx:if="{{pendingCount > 0}}" class="muted success-pending-tip">还有 {{pendingCount}} 朵在入库中，完成会持续更新</view>
      <view class="btn-ghost success-btn" bindtap="backToList">返回任务列表</view>
    </view>
  </block>

  <!-- identified（已识别未入库）：三列布局与识别结果页 batch_result 完全一致（左照片 | 中候选Top3+单选 | 右提示区） -->
  <block wx:elif="{{status === 'identified'}}">
    <view class="card batch-head-card">
      <view class="batch-name">🕐 识别批次：{{batchName}}</view>
      <view class="muted">已识别未入库，可编辑，确认入库后后台生成</view>
    </view>
    <view class="card task-items-card">
      <view wx:for="{{items}}" wx:key="fileID" class="task-item">
        <!-- 三列布局（与识别结果界面一致）：左照片固定 | 中候选Top3+单选 | 右提示区固定 -->
        <view class="task-item-head">
          <!-- 左：照片固定 150rpx，点击全屏预览 -->
          <image class="task-item-thumb" src="{{item.fileID}}" mode="aspectFill" data-fileid="{{item.fileID}}" bindtap="previewItemPhoto" />
          <!-- 中：候选 Top3 + 单选（互斥），点击整行仅选中不弹窗 -->
          <view class="task-item-main">
            <block wx:if="{{item.itemStatus === 'identified' && item.candidates.length}}">
              <view
                wx:for="{{item.candidates}}"
                wx:for-item="c"
                wx:for-index="ci"
                wx:key="index"
                class="task-candidate-row {{item.selectedIndex === ci ? 'task-candidate-row-active' : ''}}"
                data-index="{{index}}"
                data-cindex="{{ci}}"
                bindtap="selectCandidate"
              >
                <!-- 单选圆钮：三候选互斥（与识别结果界面同款） -->
                <view class="task-radio {{item.selectedIndex === ci ? 'task-radio-on' : ''}}">{{item.selectedIndex === ci ? '●' : '○'}}</view>
                <!-- 花名：点击查看花朵详情弹窗（catchtap 不触发整行选中） -->
                <text
                  class="task-candidate-row-name"
                  data-index="{{index}}"
                  data-cindex="{{ci}}"
                  catchtap="onItemFlowerNameTap"
                >{{c.species ? c.species.cnName : c.name}}</text>
                <text class="muted">{{c.scoreText}}</text>
              </view>
            </block>
            <view wx:elif="{{item.itemStatus === 'duplicate'}}" class="task-item-name task-item-fail">❌ 重复照片</view>
            <view wx:elif="{{item.itemStatus === 'nonPlant'}}" class="task-item-name task-item-fail">❌ 未识别出花朵</view>
            <view wx:elif="{{item.itemStatus === 'incomplete'}}" class="task-item-name muted">识别未完成</view>
            <view wx:elif="{{item.itemStatus === 'fail'}}" class="task-item-name task-item-fail">❌ {{item.failMsg || '识别失败'}}</view>
            <view wx:else class="task-item-name muted">暂未收录图鉴</view>
          </view>
          <!-- 右：提示区（与识别结果界面一致）：删除在上提示在下 / 已收录默认提示 / 未收录生成提示 -->
          <view class="task-item-tip">
            <!-- 非植物：删除按钮 + 提示语（删除在上、提示在下） -->
            <view wx:if="{{item.itemStatus === 'nonPlant'}}" class="task-tip-duplicate">
              <view class="btn-ghost task-op-btn task-del-btn" data-index="{{index}}" bindtap="onItemRemove">删除</view>
              <view class="task-tip-dup-note">暂未识别出花朵</view>
            </view>
            <!-- 重复照片：删除按钮 + 提示语 -->
            <view wx:elif="{{item.itemStatus === 'duplicate'}}" class="task-tip-duplicate">
              <view class="btn-ghost task-op-btn task-del-btn" data-index="{{index}}" bindtap="onItemRemove">删除</view>
              <view class="task-tip-dup-note">未识别的照片不会入库</view>
            </view>
            <!-- 识别成功：默认提示 / 未收录提示（随选中候选动态切换，与识别结果界面一致） -->
            <view wx:elif="{{item.itemStatus === 'identified' && item.candidates.length}}">
              <view wx:if="{{item.candidates[item.selectedIndex].species}}" class="task-tip-default">点击花名查看花朵详情</view>
              <view wx:else class="task-tip-uncollected">
                <view class="gen-btn gen-btn-tip">✨ 未收录，确认入库后自动生成</view>
              </view>
            </view>
            <!-- 识别中断 / 识别失败：仅提示语 -->
            <view wx:elif="{{item.itemStatus === 'incomplete'}}" class="task-tip-note">识别中断，未入库</view>
            <view wx:elif="{{item.itemStatus === 'fail'}}" class="task-tip-note">{{item.failMsg || '识别失败'}}</view>
          </view>
        </view>

        <!-- 下方操作区（与识别结果界面一致）：重复照片「继续识别 + 重新上传」；非植物「重新上传」 -->
        <view wx:if="{{item.itemStatus === 'duplicate'}}" class="task-item-ops">
          <view class="btn-ghost task-op-btn" data-index="{{index}}" bindtap="onItemRetryDuplicate">继续识别（消耗 1 次）</view>
          <view class="btn-ghost task-op-btn" data-index="{{index}}" bindtap="onItemReupload">重新上传</view>
        </view>
        <view wx:elif="{{item.itemStatus === 'nonPlant'}}" class="task-item-ops">
          <view class="btn-ghost task-op-btn" data-index="{{index}}" bindtap="onItemReupload">重新上传</view>
        </view>
      </view>
    </view>
    <view class="btn-primary task-result-btn {{locking ? 'btn-disabled' : ''}}" bindtap="confirmIdentify">确认入库</view>

    <!-- 花信息弹窗（与识别结果界面一致）：点击候选花名弹出，统一展示百科描述 -->
    <view wx:if="{{showFlowerInfo}}" class="modal-mask" bindtap="closeFlowerInfo">
      <view class="modal" catchtap="noop">
        <view class="modal-title">{{flowerInfo.cnName}}</view>
        <scroll-view scroll-y class="modal-body">
          <view class="flower-info-desc">{{flowerInfo.description || '暂无描述'}}</view>
        </scroll-view>
        <view class="btn-primary modal-btn" bindtap="closeFlowerInfo">知道了</view>
      </view>
    </view>
  </block>

  <!-- processing（识别中/已提交/终态）：确认入库后展示——照片 + 入库进度（转圈/✓/❌）+ 底部按钮（识别中/查看识别结果） -->
  <block wx:elif="{{status === 'pending' || status === 'processing' || status === 'done' || status === 'partial' || status === 'failed'}}">
    <view class="card batch-head-card">
      <view class="batch-name">🕐 识别批次：{{batchName}}</view>
      <!-- 入库进度提示：还有 N 朵在入库中（实时更新） -->
      <view wx:if="{{pendingCount > 0}}" class="muted">正在入库中，还有 {{pendingCount}} 朵在入库，可回首页操作</view>
      <view wx:else class="muted">全部入库完成</view>
    </view>
    <view class="card task-items-card">
      <view wx:for="{{items}}" wx:key="fileID" class="task-item">
        <!-- 三列布局（与识别结果界面一致）：左照片 | 中入库进度 | 右提示区 -->
        <view class="task-item-head">
          <!-- 左：照片固定尺寸，点击全屏预览 -->
          <image class="task-item-thumb" src="{{item.fileID}}" mode="aspectFill" data-fileid="{{item.fileID}}" bindtap="previewItemPhoto" />
          <!-- 中：入库进度——已完成 ✓+花名 / 失败 ❌+原因 / 处理中 转圈+花名（只显示确认时选中的那一株） -->
          <view class="task-item-main">
            <view wx:if="{{item.itemStatus === 'done'}}" class="task-saving-row">
              <view class="task-done-mark">✓</view>
              <text class="task-saving-name">{{item.displayName}}</text>
            </view>
            <view wx:elif="{{item.itemStatus === 'fail'}}" class="task-item-name task-item-fail">❌ {{item.failMsg || '入库失败'}}</view>
            <view wx:else class="task-saving-row">
              <view class="task-spinner"></view>
              <text class="task-saving-name">{{item.displayName || '识别中…'}}</text>
            </view>
          </view>
          <!-- 右：提示区（与识别结果界面一致） -->
          <view class="task-item-tip">
            <view wx:if="{{item.itemStatus === 'done'}}" class="task-tip-done">入库成功</view>
            <view wx:elif="{{item.itemStatus === 'fail'}}" class="task-tip-note">{{item.failMsg || '入库失败'}}</view>
            <view wx:else class="task-tip-saving">正在入库中…</view>
          </view>
        </view>
      </view>
    </view>
    <!-- 底部按钮：无已入库 → 「识别中」置灰不可点；有已入库 → 「查看识别结果」可点（轮询实时更新） -->
    <view class="btn-primary task-result-btn {{doneCount > 0 ? '' : 'btn-disabled'}}" bindtap="viewResult">
      {{doneCount > 0 ? '查看识别结果' : '识别中'}}
    </view>
  </block>
</view>

/* ===== 识别任务详情页 ===== */

/* 顶部批次信息卡 */
.batch-head-card {
  margin-bottom: 20rpx;
}

.batch-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

/* 照片清单卡片 */
.task-items-card {
  padding: 24rpx;
}

/* 每张照片条目：实线分割 + 头部与操作区纵向堆叠（与识别结果界面 batch-item 一致） */
.task-item {
  border-bottom: 2rpx solid #e4dcc8;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.task-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

/* ===== identified 三列布局（与识别结果界面一致）：左照片固定 | 中候选Top3+单选 | 右提示区固定 ===== */
.task-item-head {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

/* 左列照片：固定 150rpx 方图（flex-shrink 固定列宽），点击全屏预览 */
.task-item-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #f5f1e4;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(120, 100, 60, 0.12);
}

/* 中列候选：flex 占剩余宽度 */
.task-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 中列状态文案（重复/非植物/中断/失败/未收录） */
.task-item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.task-item-fail {
  color: #c0392b;
  font-weight: 400;
}

/* 候选行：整行点击仅切换选中（互斥单选），不弹窗 */
.task-candidate-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 10rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  background: #f7f4ec;
}

.task-candidate-row-active {
  background: rgba(143, 201, 154, 0.25);
}

/* 单选圆钮：三候选互斥（与识别结果界面 batch-radio 同款，选中绿底白点） */
.task-radio {
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #cbbfa0;
  color: transparent;
  font-size: 20rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.task-radio-on {
  border-color: #3e7d5c;
  background: #3e7d5c;
  color: #fff;
}

/* 花名：可点击查看花朵详情弹窗（catchtap 阻止冒泡，不触发整行选中） */
.task-candidate-row-name {
  color: #3e7d5c;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右列提示区：固定 170rpx 宽（flex-shrink 固定列宽），内容居中 */
.task-item-tip {
  width: 170rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 重复/非植物提示：删除按钮在上 + 提示语在下 */
.task-tip-duplicate {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}

.task-tip-dup-note {
  font-size: 20rpx;
  color: #9a948a;
  text-align: center;
  line-height: 1.4;
}

/* 已收录花默认提示 */
.task-tip-default {
  font-size: 22rpx;
  color: #9a948a;
  text-align: center;
  line-height: 1.5;
}

/* 识别中断/失败提示语 */
.task-tip-note {
  font-size: 22rpx;
  color: #9a948a;
  text-align: center;
  line-height: 1.5;
}

/* 未收录花提示区：生成入口胶囊铺满提示列 */
.task-tip-uncollected {
  width: 100%;
}

.task-tip-uncollected .gen-btn {
  font-size: 22rpx;
  padding: 10rpx 12rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

/* 未收录生成入口胶囊（与识别结果界面同款，纯提示：确认入库后后台生成） */
.gen-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: #eaf5ea;
  color: #3e7d5c;
  font-size: 24rpx;
  border: 2rpx solid #9fc9a6;
}

.gen-btn-tip {
  opacity: 0.7;
}

/* 下方操作区（与识别结果界面一致）：重复「继续识别 + 重新上传」/ 非植物「重新上传」 */
.task-item-ops {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.task-op-btn {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  margin: 0;
}

/* 提示区内删除按钮（红色弱化；须置于 .task-op-btn 之后以覆盖其字号/内边距） */
.task-del-btn {
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  margin: 0;
  color: #c0392b;
  border-color: #c0392b;
}

/* 确认入库按钮：提交中禁用（防重复提交） */
.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.task-result-btn {
  margin-top: 24rpx;
}

/* ===== 花信息弹窗（与识别结果界面一致）：点击候选花名弹出 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  max-height: 72vh;
  /* 弹窗背景与全局主题浅绿色一致（#eaf5ea） */
  background: #eaf5ea;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3e7d5c;
  text-align: center;
  margin-bottom: 20rpx;
}

.modal-body {
  flex: 1;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.modal-btn {
  width: 100%;
}

.flower-info-desc {
  font-size: 26rpx;
  color: #4a463c;
  line-height: 1.7;
  margin-top: 16rpx;
  border-top: 1rpx dashed #e4dcc8;
  padding-top: 16rpx;
}

/* ===== 识花结果（已收录花 swiper） ===== */
.success-wrap { text-align: center; padding-top: 40rpx; }
.success-badge { font-size: 36rpx; font-weight: 700; color: #3e7d5c; margin-bottom: 28rpx; }
.success-swiper { height: 620rpx; }
.success-card { border: 6rpx solid; border-radius: 28rpx; overflow: hidden; background: #fffdf7; box-shadow: 0 12rpx 30rpx rgba(120,100,60,0.15); margin: 0 auto; max-width: 560rpx; }
.success-img { width: 100%; height: 380rpx; display: block; }
.success-placeholder { display: flex; align-items: center; justify-content: center; font-size: 120rpx; background: #f0ece0; }
.success-info { padding: 24rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.success-name { font-size: 40rpx; font-weight: 700; }
.success-rarity { margin-top: 6rpx; }
.success-indicator { text-align: center; margin-top: 12rpx; font-size: 24rpx; }
.success-pending-tip { margin-top: 10rpx; font-size: 24rpx; }
.success-btn { width: 420rpx; margin: 20rpx auto 0; }
.rarity-common { border-color: #5fae5f; }
.rarity-rare { border-color: #5b9bd5; }
.rarity-epic { border-color: #9b59b6; }
.rarity-legendary { border-color: #c9960a; }
.badge { display: inline-block; padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 22rpx; }
.badge-common { background: #eaf5ea; color: #5fae5f; }
.badge-rare { background: #e8f1fb; color: #5b9bd5; }
.badge-epic { background: #f1e8f7; color: #9b59b6; }
.badge-legendary { background: #faf3dd; color: #c9960a; }

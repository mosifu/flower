/* ===== 识别任务详情页 ===== */
.batch-head-card {
  margin-bottom: 20rpx;
}

.batch-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.task-items-card {
  padding: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #efe9da;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f1e4;
  flex-shrink: 0;
}

.task-item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.task-item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.task-item-status {
  font-size: 22rpx;
  align-self: flex-start;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.task-item-done {
  color: #3e7d5c;
  background: #eaf5ea;
}

.task-item-generating {
  color: #8a8374;
  background: #f0ece0;
}

.task-item-fail {
  color: #c0392b;
  background: #fbeceb;
}

.task-item-failmsg {
  font-size: 22rpx;
}
/* identified 识别结果界面：候选单选 */
.task-candidate-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 8rpx;
}

.task-candidate {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  background: #f7f4ec;
}

.task-candidate-active {
  background: rgba(143, 201, 154, 0.25);
}

.task-candidate-radio {
  color: #3e7d5c;
  font-size: 22rpx;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 状态图标 */
.task-item-icon {
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 24rpx;
  flex-shrink: 0;
}

.task-icon-done {
  background: #3e7d5c;
  color: #fff;
}

.task-icon-fail {
  background: #c0392b;
  color: #fff;
}

.task-icon-spin {
  border: 4rpx solid #d5cbb0;
  border-top-color: #3e7d5c;
  border-radius: 50%;
  animation: task-spin 0.9s linear infinite;
  box-sizing: border-box;
}

@keyframes task-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.task-result-btn {
  margin-top: 24rpx;
}

/* 识花结果（复用 success 视觉） */
.success-wrap { text-align: center; padding-top: 40rpx; }
.success-badge { font-size: 36rpx; font-weight: 700; color: #3e7d5c; margin-bottom: 28rpx; }
.success-swiper { height: 620rpx; }
.success-card { border: 6rpx solid; border-radius: 28rpx; overflow: hidden; background: #fffdf7; box-shadow: 0 12rpx 30rpx rgba(120,100,60,0.15); margin: 0 auto; max-width: 560rpx; }
.success-img { width: 100%; height: 380rpx; display: block; }
.success-placeholder { display: flex; align-items: center; justify-content: center; font-size: 120rpx; background: #f0ece0; }
.success-info { padding: 24rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.success-name { font-size: 40rpx; font-weight: 700; }
.success-rarity { margin-top: 6rpx; }
.success-indicator { text-align: center; margin-top: 12rpx; font-size: 24rpx; }
.success-pending-tip { margin-top: 10rpx; font-size: 24rpx; }
.success-btn { width: 420rpx; margin: 20rpx auto 0; }
.rarity-common { border-color: #5fae5f; }
.rarity-rare { border-color: #5b9bd5; }
.rarity-epic { border-color: #9b59b6; }
.rarity-legendary { border-color: #c9960a; }
.badge { display: inline-block; padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 22rpx; }
.badge-common { background: #eaf5ea; color: #5fae5f; }
.badge-rare { background: #e8f1fb; color: #5b9bd5; }
.badge-epic { background: #f1e8f7; color: #9b59b6; }
.badge-legendary { background: #faf3dd; color: #c9960a; }
